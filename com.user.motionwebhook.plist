<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.motionwebhook</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <!-- EDIT: full path to motion_webhook.py -->
        <string>/Users/YOURNAME/motion_webhook.py</string>
        <string>--token</string>
        <!-- EDIT: pick your own long random token -->
        <string>CHANGE_ME_TO_A_LONG_RANDOM_TOKEN</string>
        <string>--cooldown</string>
        <string>120</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/motion_webhook.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/motion_webhook.err</string>
</dict>
</plist>
